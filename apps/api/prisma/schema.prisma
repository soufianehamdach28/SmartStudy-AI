// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum UsageStatus {
  SUCCESS
  FAILED
}

enum UsageKind {
  SUMMARY
  FLASHCARDS
  QUIZ
  CHAT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(STUDENT)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  documents     Document[]
  quizAttempts  QuizAttempt[]
  usageRecords  UsageRecord[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Document {
  id           String         @id @default(uuid())
  userId       String
  title        String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  status       DocumentStatus @default(UPLOADED)
  errorMessage String?
  pageCount    Int?
  summary      String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]
  flashcards  Flashcard[]
  quizzes     Quiz[]

  @@index([userId, createdAt])
  @@map("documents")
}

model DocumentChunk {
  id            String                   @id @default(uuid())
  documentId    String
  index         Int
  page          Int
  text          String                   @db.Text
  charStart     Int
  charEnd       Int
  tsv           Unsupported("tsvector")? @default(dbgenerated())
  createdAt     DateTime                 @default(now())

  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]

  @@index([documentId, index])
  @@map("document_chunks")
}

model Flashcard {
  id         String   @id @default(uuid())
  documentId String
  front      String   @db.Text
  back       String   @db.Text
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("flashcards")
}

model Quiz {
  id         String   @id @default(uuid())
  documentId String
  title      String
  createdAt  DateTime @default(now())

  document  Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([documentId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  prompt        String  @db.Text
  options       Json
  correctIndex  Int
  explanation   String  @db.Text
  sourceChunkId String?

  quiz        Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sourceChunk DocumentChunk? @relation(fields: [sourceChunkId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@index([sourceChunkId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  answers     Json
  score       Float
  completedAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model UsageRecord {
  id           String      @id @default(uuid())
  userId       String
  kind         UsageKind
  provider     String
  model        String
  tokensIn     Int         @default(0)
  tokensOut    Int         @default(0)
  costEstimate Float       @default(0.0)
  status       UsageStatus @default(SUCCESS)
  latencyMs    Int         @default(0)
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("usage_records")
}
