{
  "name": "smartstudy",
  "version": "0.1.0",
  "private": true,
  "description": "SmartStudy AI — mobile learning assistant with AI summaries, flashcards, quizzes and cited chat.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w @smartstudy/api",
    "dev:mobile": "npm run start -w @smartstudy/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prisma:migrate": "npm --workspace=@smartstudy/api run prisma:migrate",
    "prisma:generate": "npm --workspace=@smartstudy/api run prisma:generate",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write"
  }
}
